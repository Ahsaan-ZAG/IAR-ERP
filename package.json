{
  "name": "imam-ahmed-raza-academy-erp",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:init": "node database/init.js",
    "db:migrate": "node database/migrate.js",
    "db:seed": "node database/seed.js",
    "test": "node --test tests/",
    "db:clear": "node database/clear.js"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "argon2": true
  },
  "dependencies": {
    "express": "^5.3.0",
