    "ejs": "^3.1.10",
    "express-session": "^1.18.1",
    "argon2": "^0.45.2",
    "csrf-csrf": "^4.1.0",
    "cookie-parser": "^1.4.7",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "express-validator": "^7.3.2",
    "dotenv": "^17.4.2",
    "pdfkit": "^0.20.2"
  }
}
