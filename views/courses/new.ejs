<!DOCTYPE html><html><head><meta charset="UTF-8"><title><%= title %></title><link rel="stylesheet" href="/css/app.css"></head>
<body class="app-body">
  <%- include('../partials/sidebar') %>
  <div class="main-area"><%- include('../partials/navbar') %>
    <main class="content">
      <h1 class="page-title">New Course</h1>
      <div class="form-card">
        <% if (formErrors._general) { %><div class="alert-error"><%= formErrors._general %></div><% } %>
        <form method="POST" action="/courses/new">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-group"><label>Title *</label><input type="text" name="title" required maxlength="120" value="<%= formData.title || '' %>" placeholder="e.g. Nazra Quran — Level 1"></div>
          <div class="form-group"><label>Batch</label>
            <select name="batch_id"><option value="">— Any batch —</option>
              <% batches.forEach(b => { %><option value="<%= b.id %>" <%= formData.batch_id==b.id?'selected':'' %>><%= b.name %></option><% }) %></select>
          </div>
          <div class="form-group"><label>Description</label><input type="text" name="description" maxlength="300" value="<%= formData.description || '' %>"></div>
          <div class="form-actions"><button type="submit" class="btn-primary" style="width:auto">Create Course</button><a href="/courses" class="btn-link">Cancel</a></div>
        </form>
      </div>
    </main>
  </div>
</body></html>