<header class="topbar">
  <div class="topbar-title">Management System</div>
  <div class="topbar-right">
    <a href="/search" class="topbar-icon" title="Global Search">🔍</a>
    <a href="/notifications" class="topbar-icon" title="Notifications">
      🔔
      <% if (typeof unreadNotifications !== 'undefined' && unreadNotifications > 0) { %>
        <span class="notif-badge"><%= unreadNotifications %></span>
      <% } %>
    </a>
    <span class="user-badge"><%= user.display_name %> (<%= user.role %>)</span>
    <form method="POST" action="/auth/logout" style="display:inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn-logout">Logout</button>
    </form>
  </div>
<script src="/js/nav-speed.js"></script>
</header>
