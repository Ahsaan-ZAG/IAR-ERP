<!DOCTYPE html><html><head><meta charset="UTF-8"><title><%= title %></title><link rel="stylesheet" href="/css/app.css"></head>
<body class="app-body">
  <%- include('../partials/sidebar') %>
  <div class="main-area"><%- include('../partials/navbar') %>
    <main class="content">
      <% if (flash) { %><div class="alert-<%= flash.type %>"><%= flash.message %></div><% } %>
      <div class="page-header-row">
        <div><h1 class="page-title">Exams & Results</h1><p class="page-sub"><%= assessments.length %> exam(s)</p></div>
        <a href="/exams/new" class="btn-primary" style="width:auto">+ New Exam</a>
      </div>
      <form method="GET" action="/exams" class="filter-bar">
        <select name="batch"><option value="">All Batches</option>
          <% batches.forEach(b => { %><option value="<%= b.id %>" <%= filters.batchId===b.id?'selected':'' %>><%= b.name %></option><% }) %></select>
        <select name="type"><option value="">All Types</option>
          <% ['test','quiz','midterm','final'].forEach(t => { %><option value="<%= t %>" <%= filters.type===t?'selected':'' %>><%= t %></option><% }) %></select>
        <button type="submit" class="btn-secondary">Filter</button>
        <a href="/exams" class="btn-link">Reset</a>
      </form>
      <% if (assessments.length === 0) { %><div class="empty-state"><p>No exams yet.</p></div>
      <% } else { %>
        <div class="table-wrap"><table class="data-table">
          <thead><tr><th>Title</th><th>Type</th><th>Batch</th><th>Date</th><th>Max Marks</th><th>Results</th><th></th></tr></thead>
          <tbody>
            <% assessments.forEach(a => { %><tr>
              <td><a href="/exams/<%= a.id %>"><%= a.title %></a></td>
              <td><span class="badge badge-muted"><%= a.type %></span></td>
              <td><%= a.batch_name %></td>
              <td><%= a.exam_date %></td>
              <td><%= a.max_marks %></td>
              <td><%= a.results_count %></td>
              <td><a href="/exams/<%= a.id %>" class="btn-link">Enter Results</a></td>
            </tr><% }) %>
          </tbody>
        </table></div>
      <% } %>
    </main>
  </div>
</body></html>