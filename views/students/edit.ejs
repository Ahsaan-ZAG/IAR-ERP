<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="app-body">
  <%- include('../partials/sidebar') %>
  <div class="main-area">
    <%- include('../partials/navbar') %>
    <main class="content">
      <h1 class="page-title">Edit Student</h1>
      <p class="page-sub">
        <code><%= student.roll_no %></code> ·
        Roll number cannot be edited.
      </p>

      <div class="form-card">
        <% if (formErrors._general) { %><div class="alert-error"><%= formErrors._general %></div><% } %>

        <form method="POST" action="/students/<%= student.id %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="form-group">
            <label for="name">Student Name *</label>
            <input type="text" id="name" name="name" required maxlength="100"
                   value="<%= formData.name %>">
            <% if (formErrors.name) { %><div class="form-error"><%= formErrors.name %></div><% } %>
          </div>

          <div class="form-group">
            <label for="father_name">Father Name *</label>
            <input type="text" id="father_name" name="father_name" required maxlength="100"
                   value="<%= formData.father_name %>">
            <% if (formErrors.father_name) { %><div class="form-error"><%= formErrors.father_name %></div><% } %>
          </div>

          <div class="form-group">
            <label for="batch_id">Batch</label>
            <select id="batch_id" name="batch_id">
              <option value="">— Unassigned —</option>
              <% batches.forEach(b => { %>
                <option value="<%= b.id %>" <%= String(formData.batch_id) === String(b.id) ? 'selected' : '' %>><%= b.name %></option>
              <% }) %>
            </select>
            <% if (formErrors.batch_id) { %><div class="form-error"><%= formErrors.batch_id %></div><% } %>
          </div>

          <div class="form-group">
            <label for="status">Status</label>
            <select id="status" name="status" required>
              <option value="active" <%= formData.status === 'active' ? 'selected' : '' %>>Active</option>
              <option value="inactive" <%= formData.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
            </select>
            <% if (formErrors.status) { %><div class="form-error"><%= formErrors.status %></div><% } %>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn-primary" style="width:auto">Save Changes</button>
            <a href="/students/<%= student.id %>" class="btn-link">Cancel</a>
          </div>
        </form>
      </div>
    </main>
  </div>
</body>
</html>