<!DOCTYPE html><html><head><meta charset="UTF-8"><title><%= title %></title><link rel="stylesheet" href="/css/app.css"></head>
<body class="app-body">
  <%- include('../partials/sidebar') %>
  <div class="main-area"><%- include('../partials/navbar') %>
    <main class="content">
      <h1 class="page-title">New Holiday</h1>
      <p class="page-sub">Holiday declaration blocks attendance and marks batch sessions as holiday for selected batches.</p>

      <div class="form-card" style="max-width:720px">
        <% if (formErrors._general) { %><div class="alert-error"><%= formErrors._general %></div><% } %>
        <form method="POST" action="/holidays/new">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="form-group"><label>Title *</label>
            <input type="text" name="title" required maxlength="100" value="<%= formData.title || '' %>" placeholder="e.g. Eid Milad-un-Nabi">
          </div>

          <div class="form-group"><label>Reason</label>
            <input type="text" name="reason" maxlength="200" value="<%= formData.reason || '' %>" placeholder="Optional note">
          </div>

          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
            <div class="form-group"><label>Start Date *</label>
              <input type="date" name="start_date" required value="<%= formData.start_date || today %>">
            </div>
            <div class="form-group"><label>End Date *</label>
              <input type="date" name="end_date" required value="<%= formData.end_date || today %>">
            </div>
          </div>

          <div class="form-group">
            <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
              <input type="checkbox" name="is_full_day" value="1" <%= formData.is_full_day !== false ? 'checked' : '' %> onchange="document.getElementById('partialFields').style.display = this.checked ? 'none' : 'block'">
              Full day holiday
            </label>
          </div>

          <div id="partialFields" style="display:<%= formData.is_full_day === false ? 'block' : 'none' %>;padding:14px;background:#F9FAFB;border-radius:8px;margin-bottom:16px">
            <p style="font-size:12px;color:#737784;margin-bottom:12px">Partial day: only batches whose scheduled time overlaps the window below are affected.</p>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
              <div class="form-group"><label>Partial Start</label>
                <input type="time" name="partial_start" value="<%= formData.partial_start || '' %>">
              </div>
              <div class="form-group"><label>Partial End</label>
                <input type="time" name="partial_end" value="<%= formData.partial_end || '' %>">
              </div>
            </div>
          </div>

          <div class="form-group">
            <label>Affected Batches</label>
            <label style="display:flex;align-items:center;gap:8px;margin-bottom:8px;cursor:pointer">
              <input type="checkbox" name="all_batches" value="1" <%= formData.all_batches !== false ? 'checked' : '' %> onchange="document.querySelectorAll('[name=batch_ids]').forEach(c => c.disabled = this.checked)">
              All batches
            </label>
            <div style="padding-left:22px">
              <% batches.forEach(b => { %>
                <label style="display:flex;align-items:center;gap:8px;margin-bottom:6px;cursor:pointer">
                  <input type="checkbox" name="batch_ids" value="<%= b.id %>" <%= Array.isArray(formData.batch_ids) && formData.batch_ids.map(String).includes(String(b.id)) ? 'checked' : '' %>>
                  <%= b.name %> <span class="muted" style="font-size:12px">(<%= b.start_time %> – <%= b.end_time %>)</span>
                </label>
              <% }) %>
            </div>
            <p class="muted" style="font-size:12px;margin-top:8px">Unchecked batches run normally (special working session).</p>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn-primary" style="width:auto">Create Holiday</button>
            <a href="/holidays" class="btn-link">Cancel</a>
          </div>
        </form>
      </div>
    </main>
  </div>
</body></html>