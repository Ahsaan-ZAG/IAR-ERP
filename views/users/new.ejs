<!DOCTYPE html><html><head><meta charset="UTF-8"><title><%= title %></title><link rel="stylesheet" href="/css/app.css"></head>
<body class="app-body">
  <%- include('../partials/sidebar') %>
  <div class="main-area"><%- include('../partials/navbar') %>
    <main class="content">
      <h1 class="page-title">New User</h1>
      <div class="form-card">
        <% if (formErrors._general) { %><div class="alert-error"><%= formErrors._general %></div><% } %>
        <form method="POST" action="/users/new">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-group"><label>Username *</label><input type="text" name="username" required minlength="3" maxlength="40" value="<%= formData.username || '' %>" placeholder="lowercase, digits, underscore"></div>
          <div class="form-group"><label>Display Name *</label><input type="text" name="display_name" required maxlength="80" value="<%= formData.display_name || '' %>"></div>
          <div class="form-group"><label>Password * (min 8 chars)</label><input type="password" name="password" required minlength="8" maxlength="200"></div>
          <div class="form-group"><label>Role *</label>
            <select name="role" required>
              <option value="teacher" <%= formData.role === 'teacher' ? 'selected' : '' %>>Teacher</option>
              <option value="admin" <%= formData.role === 'admin' ? 'selected' : '' %>>Admin</option>
            </select>
          </div>
          <div class="form-actions"><button type="submit" class="btn-primary" style="width:auto">Create User</button><a href="/users" class="btn-link">Cancel</a></div>
        </form>
      </div>
    </main>
  </div>
</body></html>