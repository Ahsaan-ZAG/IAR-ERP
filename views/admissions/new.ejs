<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="app-body">
  <%- include('../partials/sidebar') %>
  <div class="main-area">
    <%- include('../partials/navbar') %>
    <main class="content">
      <h1 class="page-title">New Admission</h1>
      <p class="page-sub">
        Admission form accepts only <strong>Student Name</strong> and <strong>Father Name</strong>.
        Roll number is generated automatically and cannot be edited.
      </p>

      <div class="form-card">
        <% if (formErrors._general) { %><div class="alert-error"><%= formErrors._general %></div><% } %>

        <form method="POST" action="/admissions/new">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="form-group">
            <label for="name">Student Name *</label>
            <input type="text" id="name" name="name" required maxlength="100"
                   value="<%= formData.name || '' %>" autocomplete="off" autofocus>
            <% if (formErrors.name) { %><div class="form-error"><%= formErrors.name %></div><% } %>
          </div>

          <div class="form-group">
            <label for="father_name">Father Name *</label>
            <input type="text" id="father_name" name="father_name" required maxlength="100"
                   value="<%= formData.father_name || '' %>" autocomplete="off">
            <% if (formErrors.father_name) { %><div class="form-error"><%= formErrors.father_name %></div><% } %>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn-primary" style="width:auto">Create Admission</button>
            <a href="/students" class="btn-link">Cancel</a>
          </div>
        </form>
      </div>
    </main>
  </div>
</body>
</html>